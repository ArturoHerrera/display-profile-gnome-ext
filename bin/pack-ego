#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "=================================================="
echo "  EMPAQUETADOR OFICIAL PARA EXTENSIONS.GNOME.ORG"
echo "  display-profiles@arturoherrera (v1.0.2 / EGO v3)"
echo "=================================================="

DIST_DIR="$PROJECT_ROOT/dist"
SRC_DIR="$PROJECT_ROOT/src"
PO_DIR="$PROJECT_ROOT/po"

mkdir -p "$DIST_DIR"
mkdir -p "$SRC_DIR/locale/es/LC_MESSAGES"

# 1. Compilar catálogo de traducciones localmente
echo "[1/4] Compilando traducciones gettext..."
msgfmt -cv -o "$SRC_DIR/locale/es/LC_MESSAGES/display-profiles@arturoherrera.mo" "$PO_DIR/es.po"

# 2. Empaquetar con gnome-extensions pack
echo "[2/4] Generando bundle de extensión con gnome-extensions pack..."
(
    cd "$SRC_DIR"
    gnome-extensions pack \
        --extra-source=displayManager.js \
        --extra-source=storage.js \
        --podir="$PO_DIR" \
        --gettext-domain=display-profiles@arturoherrera \
        --out-dir="$DIST_DIR" \
        --force \
        .
)

ZIP_FILE="$DIST_DIR/display-profiles@arturoherrera.shell-extension.zip"

if [[ ! -f "$ZIP_FILE" ]]; then
    echo "ERROR: No se encontró el archivo generado en $ZIP_FILE" >&2
    exit 1
fi

# 3. Auditoría estática con Shexli
echo "[3/4] Ejecutando análisis estático con Shexli..."
"$SCRIPT_DIR/lint-shexli" "$ZIP_FILE"

# 4. Validar contenido del paquete
echo "[4/4] Verificando contenido del paquete EGO..."
unzip -l "$ZIP_FILE"

echo ""
echo "=================================================="
echo "  ¡PAQUETE EGO GENERADO CON ÉXITO!"
echo "  Ubicación: $ZIP_FILE"
echo "  Listo para subir a https://extensions.gnome.org"
echo "=================================================="
